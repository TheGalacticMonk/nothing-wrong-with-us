# Random string used to sign logins. Generate with: openssl rand -hex 32
# In production set it as a Worker secret: wrangler secret put PAYLOAD_SECRET
PAYLOAD_SECRET=
# Public URL of this app (used for preview links and canonical URLs). No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Local development accounts, created by `pnpm seed` only while the users table is empty.
# Leave empty here; put real values in .env (git-ignored). Never reuse these in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
