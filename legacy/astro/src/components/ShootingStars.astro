---
// Decorative only: six pink shooting stars streaking down-left behind the page.
// Adapted from a CodePen button; hidden entirely for reduced-motion and print.
---

<div class="shooting-stars no-print" aria-hidden="true">
  <span class="shooting-star s1"></span>
  <span class="shooting-star s2"></span>
  <span class="shooting-star s3"></span>
  <span class="shooting-star s4"></span>
  <span class="shooting-star s5"></span>
  <span class="shooting-star s6"></span>
</div>

<style>
  .shooting-stars {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shooting-stars {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .shooting-star {
      --len: 220px;
      /* Fixed distance (not vw/vmax) so the speed is the same at every window size. */
      --dx: -1200px;
      /* tan(40deg) ~ 0.839: keeps the path parallel to the rotated streak. */
      --dy: calc(var(--dx) * -0.839);
      position: absolute;
      width: var(--len);
      height: 3px;
      border-radius: 999px;
      /* Bright head on the left (the leading end), fading to a soft pink tail. */
      background: linear-gradient(
        80deg,
        #ffe6f8 0%,
        var(--color-orchid-300) 12%,
        var(--color-orchid-400) 45%,
        rgb(224 134 212 / 0) 100%
      );
      box-shadow:
        0 0 10px 1px rgb(224 134 212 / 0.75),
        0 0 26px 4px rgb(236 56 188 / 0.35);
      opacity: 0;
      transform: rotate(-40deg);
      animation: shooting-star var(--dur) cubic-bezier(0.15, 0.83, 0.66, 1) var(--delay) infinite;
      will-change: transform, opacity;
    }

    .s1 {
      top: -3%;
      left: 92%;
      --dur: 4.8s;
      --delay: 0s;
    }
    .s2 {
      top: 6%;
      left: 62%;
      --len: 300px;
      --dur: 4.8s;
      --delay: -0.6s;
    }
    .s3 {
      top: -5%;
      left: 38%;
      --len: 170px;
      --dur: 4.8s;
      --delay: -1.7s;
    }
    .s4 {
      top: 20%;
      left: 104%;
      --len: 260px;
      --dur: 4.8s;
      --delay: -2.3s;
    }
    .s5 {
      top: -4%;
      left: 76%;
      --len: 190px;
      --dur: 4.8s;
      --delay: -3.4s;
    }
    .s6 {
      top: 34%;
      left: 108%;
      --len: 240px;
      --dur: 4.8s;
      --delay: -4.1s;
    }

    /* Streaks for the first 35% of each cycle, then rests until the next pass. */
    @keyframes shooting-star {
      0% {
        opacity: 0;
        transform: translate(0, 0) rotate(-40deg);
      }
      4% {
        opacity: 1;
      }
      31% {
        opacity: 1;
      }
      35%,
      100% {
        opacity: 0;
        transform: translate(var(--dx), var(--dy)) rotate(-40deg);
      }
    }
  }
</style>
