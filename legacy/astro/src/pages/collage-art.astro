---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArtNav from '@/components/ArtNav.astro';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('collage')).sort((a, b) => a.id.localeCompare(b.id));
const items = await Promise.all(
  entries.map(async (entry) => ({
    id: entry.id,
    alt: entry.data.alt,
    image: entry.data.image,
    ratio: entry.data.image.width / entry.data.image.height,
    full: (await getImage({ src: entry.data.image, width: 1600, format: 'webp', quality: 82 })).src,
  })),
);
---

<BaseLayout
  title="Collage"
  description="Collage art by Becca Berry: cut-up magazines, headlines and faces rearranged into visual testimony, made as part of her healing."
>
  <PageHeader eyebrow="Art" title="Collage">
    <div class="nav">
      <ArtNav />
    </div>
  </PageHeader>

  <div class="wrap">
    <ul class="gallery">
      {items.map((item, i) => (
        <li
          class:list={{ wide: item.ratio > 1.15 }}
          data-fit={item.ratio > 2.2 ? 'contain' : 'cover'}
        >
          <button
            type="button"
            class="thumb"
            data-full={item.full}
            data-alt={item.alt}
            aria-haspopup="dialog"
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[320, 480, 640, 800]}
              sizes={
                item.ratio > 1.15
                  ? '(min-width: 64rem) 50vw, (min-width: 40rem) 66vw, 100vw'
                  : '(min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw'
              }
              quality={item.ratio > 1.15 ? 45 : 60}
              loading={i < 2 ? 'eager' : 'lazy'}
              fetchpriority={i < 1 ? 'high' : undefined}
            />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog id="viewer" class="viewer" aria-label="Collage viewer">
    <div class="viewer-bar">
      <p class="label" id="viewer-count" aria-live="polite"></p>
      <button type="button" class="label vbtn" data-close>
        Close ✕
      </button>
    </div>
    <img id="viewer-img" alt="" />
    <p id="viewer-alt" class="viewer-alt"></p>
    <div class="viewer-nav">
      <button type="button" class="label vbtn" data-prev>
        ← Previous
      </button>
      <button type="button" class="label vbtn" data-next>
        Next →
      </button>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#viewer');
  const img = document.querySelector<HTMLImageElement>('#viewer-img');
  const alt = document.querySelector<HTMLElement>('#viewer-alt');
  const count = document.querySelector<HTMLElement>('#viewer-count');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];

  if (dialog && img && alt && count && thumbs.length) {
    let index = 0;
    const show = (next: number) => {
      index = (next + thumbs.length) % thumbs.length;
      const t = thumbs[index];
      img.src = t.dataset.full ?? '';
      img.alt = t.dataset.alt ?? '';
      alt.textContent = t.dataset.alt ?? '';
      count.textContent = `${index + 1} of ${thumbs.length}`;
    };
    thumbs.forEach((t, i) =>
      t.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // A click on the backdrop (which targets the dialog element itself) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .nav {
    margin-top: 2rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 0.75rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 40rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  @media (min-width: 64rem) {
    .gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .gallery li {
    aspect-ratio: 4 / 5;
  }
  /* Landscape pieces take two columns; the ratio keeps them level with their portrait neighbours. */
  .gallery li.wide {
    grid-column: span 2;
    aspect-ratio: 8 / 5;
  }
  .thumb {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    cursor: zoom-in;
    background: var(--color-night-800);
    border: 2px solid transparent;
  }
  .thumb:hover {
    border-color: var(--color-orchid-400);
  }
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  li[data-fit='contain'] .thumb :global(img) {
    object-fit: contain;
  }

  .viewer {
    width: min(100vw, 70rem);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: auto;
    padding: 1rem;
    color: var(--fg);
    background: var(--color-night-950);
    border: 0;
  }
  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: 0.75rem;
  }
  .viewer::backdrop {
    background: rgb(5 8 23 / 0.92);
  }
  .viewer-bar,
  .viewer-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .viewer img {
    justify-self: center;
    width: auto;
    max-width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .viewer-alt {
    max-width: 44rem;
    margin-inline: auto;
    font-size: 1rem;
    text-align: center;
    color: var(--fg-muted);
  }
  .vbtn {
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    color: var(--fg);
    cursor: pointer;
    background: transparent;
    border: 2px solid var(--rule);
  }
  .vbtn:hover {
    color: var(--color-night-950);
    background: var(--color-star-300);
    border-color: var(--color-star-300);
  }
</style>
