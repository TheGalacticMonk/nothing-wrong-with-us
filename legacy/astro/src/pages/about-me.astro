---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import ContentNote from '@/components/ContentNote.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import portrait from '@/assets/becca-portrait.webp';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing content entry: pages/about');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="wrap intro">
    <p class="label eyebrow">About Me</p>
    <h1>
      Nobody is coming to save you. <em>You can save yourself!</em>
    </h1>
    <p class="lede">For the ones who survived what they can’t say out loud—yet</p>
    <ul class="chants">
      <li>You’re not alone.</li>
      <li>You’re not too much.</li>
      <li>You’re not crazy.</li>
      <li class="strong">You survived.</li>
    </ul>
    <p class="connect">
      Connect with Becca Berry{' '}
      <a href="https://www.instagram.com/beccaberry" target="_blank" rel="noopener noreferrer">
        @beccaberry
      </a>
    </p>
    <div class="note">
      <ContentNote />
    </div>
  </header>

  <div class="wrap layout">
    <figure class="portrait">
      <Image
        src={portrait}
        alt="Becca Berry looking directly at the camera, with russet locs and a sheer black rose-print top."
        widths={[360, 560, 760]}
        sizes="(min-width: 64rem) 26rem, 90vw"
        quality={80}
        loading="eager"
      />
    </figure>
    <article class="on-paper paper wave-top wave-bottom panel">
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) 2.5rem;
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-star-300);
  }
  h1 {
    max-width: 16ch;
    font-size: var(--text-h1);
    line-height: var(--text-h1--line-height);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  h1 em {
    font-weight: 300;
    color: var(--color-orchid-400);
  }
  .lede {
    max-width: 30rem;
    margin-top: 1.75rem;
    font-size: var(--text-lede);
    font-style: italic;
    color: var(--fg-muted);
  }
  .chants {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-style: italic;
    line-height: 1.35;
  }
  .chants .strong {
    font-style: normal;
    font-weight: 700;
    color: var(--color-orchid-400);
  }
  .connect {
    margin-top: 1.5rem;
    color: var(--fg-muted);
  }
  .note {
    margin-top: 2rem;
  }

  .layout {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding-bottom: 2rem;
  }
  .portrait {
    max-width: 24rem;
    transform: rotate(-1.5deg);
    border: 0.6rem solid var(--color-paper-50);
    box-shadow: 0 12px 34px rgb(0 0 0 / 0.5);
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 100%;
  }
  .panel {
    padding-inline: clamp(1.5rem, 5vw, 4rem);
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: 3rem;
    }
    .portrait {
      position: sticky;
      top: 6.5rem;
    }
  }
</style>
