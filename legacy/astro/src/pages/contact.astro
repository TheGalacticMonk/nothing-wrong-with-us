---
import ContactForm from '@/components/ContactForm.astro';
import CrisisResources from '@/components/CrisisResources.astro';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { featuredMedia, social } from '@/config/site';
---

<BaseLayout
  title="Info + Contact"
  description="About Nothing Wrong With You, Becca Berry’s social media, and how to reach her for booking, press and collaboration. Based in Los Angeles, CA."
>
  <PageHeader
    eyebrow="Info + Contact"
    title="I’d love to hear from you"
    lede="About me, social media, and how to get in touch"
  />

  <div class="wrap layout">
    <div class="info">
      <section aria-labelledby="about-heading">
        <h2 id="about-heading" class="label">
          About
        </h2>
        <div class="prose">
          <p>
            <em>Nothing Wrong With You</em> is a spiritual and artistic storytelling platform for
            survivors curated by Becca Berry, Esq. I believe that every survivor deserves to heal
            and thrive, and I am committed to providing survivors with the space they need to do so.
          </p>
          <p>
            Welcome to <em>Nothing Wrong With You</em>. To learn a little more about Becca Berry’s
            story, you can watch this{' '}
            <a href={featuredMedia.video} target="_blank" rel="noopener noreferrer">
              short video
            </a>
            .
          </p>
          <p>
            I am open to sharing more and collaborating with other survivors so please feel free to
            contact me on any of the linked social media platforms or send me a message.
          </p>
        </div>
      </section>

      <section aria-labelledby="follow-heading">
        <h2 id="follow-heading" class="label">
          Follow
        </h2>
        <ul class="social">
          {social.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="booking-heading">
        <h2 id="booking-heading" class="label">
          Booking + Press
        </h2>
        <address>
          Becca Berry
          <br />
          Los Angeles, CA
        </address>
        <p class="hint">Choose “Booking” or “Press” in the form.</p>
      </section>

      <CrisisResources />
    </div>

    <div class="on-paper paper wave-top wave-bottom form-panel">
      <ContactForm />
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: 3rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
    .form-panel {
      position: sticky;
      top: 6rem;
    }
  }
  .info {
    display: grid;
    gap: 2.5rem;
  }
  h2 {
    margin-bottom: 0.9rem;
    color: var(--color-star-300);
  }
  address {
    font-size: 1.15rem;
    font-style: normal;
  }
  .hint {
    margin-top: 0.4rem;
    color: var(--fg-muted);
  }
  .social {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-style: italic;
  }
  .social a {
    display: inline-block;
    padding-block: 0.2rem;
  }
  .form-panel {
    padding-inline: clamp(1.5rem, 4vw, 3rem);
  }
</style>
