---
import { artSections, mainNav } from '@/config/site';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const links = [...mainNav, ...artSections];
---

<BaseLayout title="Page not found" description="That page could not be found." noindex>
  <PageHeader eyebrow="404" title="Page not found" />
  <div class="wrap">
    <p class="btn-row">
      <a class="btn" href="/">
        Back to the home page
      </a>
    </p>
    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    font-size: 1.2rem;
  }
</style>
