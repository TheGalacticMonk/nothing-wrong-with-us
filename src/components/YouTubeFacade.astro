---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
}
const { id, title, poster } = Astro.props;
---

<!--
  Privacy-first embed: no request reaches YouTube until the visitor chooses to play.
  Without JavaScript the poster is a plain link to the video on YouTube.
-->
<div class="yt" data-yt-id={id} data-yt-title={title}>
  <a
    class="yt-link"
    href={`https://www.youtube.com/watch?v=${id}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Play “${title}” video`}
  >
    <Image
      src={poster}
      alt=""
      widths={[480, 720, 960]}
      sizes="(min-width: 64rem) 40vw, 92vw"
      quality={70}
    />
    <span class="play label" aria-hidden="true">
      ▶ Play
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((box) => {
    const link = box.querySelector<HTMLAnchorElement>('.yt-link');
    link?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = box.dataset.ytTitle ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-night-950);
  }
  .yt-link {
    position: relative;
    display: block;
    height: 100%;
  }
  .yt :global(img),
  .yt :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    padding: 0.7rem 1.6rem;
    font-size: 1.15rem;
    color: var(--color-night-950);
    background: var(--color-orchid-400);
    transform: translate(-50%, -50%);
    transition: background-color 0.2s;
  }
  .yt-link:hover .play {
    background: var(--color-star-300);
  }
</style>
